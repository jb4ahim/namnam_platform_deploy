{
  "name": "namnam_platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/namnam_platform/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/namnam_platform/test/jest-e2e.json",
    "build:customer": "prisma generate && nest build customer_api",
    "build:merchant": "prisma generate && nest build merchant_api",
    "build:management": "prisma generate && nest build management_api",
    "build:driver": "prisma generate && nest build driver_api",
    "start:customer": "node dist/apps/customer_api/main.js",
    "start:dev:customer": "nest start customer_api --watch",
    "start:merchant": "node dist/apps/merchant_api/main.js",
    "start:dev:merchant": "nest start merchant_api --watch",
    "start:management": "node dist/apps/management_api/main.js",
    "start:dev:management": "nest start management_api --watch",
    "start:driver": "node dist/apps/driver_api/main.js",
    "start:dev:driver": "nest start driver_api --watch",
    "start:dev:all": "run-p start:dev:customer start:dev:merchant start:dev:management start:dev:driver"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-presigned-post": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@blazity/nest-file-fastify": "^1.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.5",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@react-email/components": "^0.4.0",
    "@scalar/fastify-api-reference": "^1.49.1",
    "@scalar/nestjs-api-reference": "^1.1.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "eslint": "^9.18.0",
    "file-type": "^21.0.0",
    "firebase-admin": "^13.5.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.0",
    "jest": "^29.7.0",
    "jose": "^6.0.12",
    "nest-winston": "^1.10.2",
    "nodemailer": "^7.0.5",
    "npm-run-all": "^4.1.5",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "twilio": "^5.8.0",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/server-postgres": "^0.6.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/client": "^7.5.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/notifications(|/.*)$": "<rootDir>/libs/notifications/src/$1"
    }
  }
}
