{
  "info": {
    "name": "Management API – Categories",
    "description": "Category endpoints for the management panel.\n\n## Authentication\nAll requests require a Bearer JWT token obtained from `POST /auth/login`.\n\nRun **Login** first; the test script saves `token` automatically. You can also paste a JWT into the `token` collection variable.\n\nThe app uses a global prefix of `/api`, so the default `baseUrl` is `http://localhost:3003/api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003/api",
      "description": "Management API base URL (includes /api prefix)"
    },
    {
      "key": "token",
      "value": "",
      "description": "Bearer JWT – set automatically by Login, or paste from POST /auth/login"
    },
    {
      "key": "categoryId",
      "value": "1",
      "description": "Category ID used by Update and Delete"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.accessToken || json?.accessToken;",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@management.com\",\n  \"password\": \"SecureP@ssw0rd\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login as a management user. Saves `token` from the response for the other requests."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?parentId=0",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "parentId", "value": "0", "description": "Optional. Use 0 for top-level categories." }
              ]
            },
            "description": "List categories. Omit parentId or use 0 for top-level categories."
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Burgers\",\n  \"parentId\": 1,\n  \"status\": \"active\",\n  \"imageKey\": \"categories/burgers.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a category. `parentId`, `status`, and `imageKey` are optional."
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Burgers\",\n  \"status\": \"active\",\n  \"imageKey\": \"categories/burgers.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update an existing category by ID."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "Delete a category by ID. Requires Authorization.\n\nUnlinks child categories (they become top-level), removes product-category links, and clears merchant/promotion category references before deleting the row."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"statusCode\": 200,\n  \"message\": \"Success\",\n  \"data\": {\n    \"success\": true\n  }\n}"
            },
            {
              "name": "Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            },
            {
              "name": "Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"success\": false,\n  \"statusCode\": 404,\n  \"message\": \"Category with ID 1 not found\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
