{
  "info": {
    "name": "Namnam Customer API",
    "_postman_id": "d7e3c202-6f8d-4c64-982c-04a5b18f5f4c",
    "description": "Complete Postman collection for the Customer API. The app runs with a global prefix of `/api`, so the default `baseUrl` is `http://localhost:3002/api`. Most routes are protected by the JWT AuthGuard and expect the Authorization header `Bearer {{accessToken}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002/api"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "Set after login/verify. Used by default for protected routes."
    },
    {
      "key": "promotionId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "merchantId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "addressId",
      "value": "1"
    },
    {
      "key": "cartItemId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+961\",\n  \"phoneNumber\": \"70000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Triggers OTP generation for a phone number. No auth required."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+961\",\n  \"phoneNumber\": \"70000000\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Validates the OTP. Returns `{ isRegistered: true, accessToken, refreshToken }` for existing users or `{ isRegistered: false, verifyToken, expiresAt }` for new users."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"gender\": \"female\",\n  \"birthday\": \"1990-01-01\",\n  \"defaultCurrency\": \"USD\",\n  \"status\": \"active\",\n  \"verifyToken\": \"{{verifyTokenFromVerifyOtp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Completes registration for users who passed OTP verification. Use the `verifyToken` returned by Verify OTP."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Returns a fresh `{ accessToken, refreshToken }` pair."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Requires Authorization. Returns the authenticated user's profile."
          }
        }
      ]
    },
    {
      "name": "App Config",
      "item": [
        {
          "name": "Get Home Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app-config/home?zoneId=1",
              "host": ["{{baseUrl}}"],
              "path": ["app-config", "home"],
              "query": [
                { "key": "zoneId", "value": "1", "description": "Optional zone filter" }
              ]
            },
            "description": "Fetches home page configuration. Public endpoint."
          }
        }
      ]
    },
    {
      "name": "Promotions",
      "item": [
        {
          "name": "List Promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/promotions?categoryId={{categoryId}}&isFeatured=true&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["promotions"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}", "description": "Optional category filter" },
                { "key": "isFeatured", "value": "true", "description": "Optional featured flag" },
                { "key": "limit", "value": "10", "description": "Optional max results" }
              ]
            },
            "description": "Lists promotions. Public endpoint."
          }
        },
        {
          "name": "Get Promotion By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/promotions/{{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["promotions", "{{promotionId}}"]
            },
            "description": "Requires Authorization. Fetches a single promotion."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?merchantId={{merchantId}}&categoryId={{categoryId}}&minPrice=0&maxPrice=100&isAvailable=true&hasDiscount=false&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "merchantId", "value": "{{merchantId}}", "description": "Required merchant id" },
                { "key": "categoryId", "value": "{{categoryId}}", "description": "Optional category filter" },
                { "key": "minPrice", "value": "0", "description": "Optional minimum price" },
                { "key": "maxPrice", "value": "100", "description": "Optional maximum price" },
                { "key": "isAvailable", "value": "true", "description": "Optional availability flag" },
                { "key": "hasDiscount", "value": "false", "description": "Optional discount flag" },
                { "key": "limit", "value": "20", "description": "Optional max results" }
              ]
            },
            "description": "Requires Authorization. Lists products for a merchant with optional filters."
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Requires Authorization. Fetches a single product."
          }
        }
      ]
    },
    {
      "name": "Merchants",
      "item": [
        {
          "name": "List Merchants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/merchants?latitude=33.8938&longitude=35.5018&categoryId={{categoryId}}&zoneId=1&minRating=3&isOpen=true&hasDiscount=true&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["merchants"],
              "query": [
                { "key": "latitude", "value": "33.8938", "description": "Optional latitude for distance sorting" },
                { "key": "longitude", "value": "35.5018", "description": "Optional longitude for distance sorting" },
                { "key": "categoryId", "value": "{{categoryId}}", "description": "Optional category filter" },
                { "key": "zoneId", "value": "1", "description": "Optional zone filter" },
                { "key": "minRating", "value": "3", "description": "Optional minimum rating" },
                { "key": "isOpen", "value": "true", "description": "Optional open flag" },
                { "key": "hasDiscount", "value": "true", "description": "Optional discount flag" },
                { "key": "limit", "value": "10", "description": "Optional max results" }
              ]
            },
            "description": "Requires Authorization. Lists merchants with optional filters."
          }
        },
        {
          "name": "Get Merchant By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["merchants", "{{merchantId}}"]
            },
            "description": "Requires Authorization. Fetches a single merchant."
          }
        }
      ]
    },
