    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?merchantId={{merchantId}}&categoryId={{categoryId}}&minPrice=0&maxPrice=100&isAvailable=true&hasDiscount=false&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "merchantId", "value": "{{merchantId}}", "description": "Required merchant id" },
                { "key": "categoryId", "value": "{{categoryId}}", "description": "Optional category filter (provide to avoid ParseIntPipe errors)" },
                { "key": "minPrice", "value": "0", "description": "Optional minimum price" },
                { "key": "maxPrice", "value": "100", "description": "Optional maximum price" },
                { "key": "isAvailable", "value": "true", "description": "Optional availability flag; repository defaults true and ignores false" },
                { "key": "hasDiscount", "value": "false", "description": "Optional discount flag; false becomes null in repository" },
                { "key": "limit", "value": "20", "description": "Optional max results" }
              ]
            },
            "description": "Requires Authorization. Lists products for a merchant with optional filters. Note: repository forces isAvailable=true by default and treats hasDiscount=false as null."
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
