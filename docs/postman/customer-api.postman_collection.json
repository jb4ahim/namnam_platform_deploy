{
  "info": {
    "name": "Namnam Customer API",
    "_postman_id": "d7e3c202-6f8d-4c64-982c-04a5b18f5f4c",
    "description": "Complete Postman collection for the Customer API. The app runs with a global prefix of `/api`, so the default `baseUrl` is `http://localhost:3002/api`. Most routes are protected by the JWT AuthGuard and expect the Authorization header `Bearer {{accessToken}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002/api"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "Set after login/verify. Used by default for protected routes."
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "Set from verify/register response when available."
    },
    {
      "key": "promotionId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "merchantId",
      "value": "1"
    },
    {
      "key": "reviewId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "addressId",
      "value": "1"
    },
    {
      "key": "cartItemId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "notificationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+961\",\n  \"phoneNumber\": \"70000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Triggers OTP generation for a phone number. No auth required."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+961\",\n  \"phoneNumber\": \"70000000\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Validates the OTP. Returns `{ isRegistered: true, accessToken, refreshToken }` for existing users or `{ isRegistered: false, verifyToken, expiresAt }` for new users."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"gender\": \"female\",\n  \"birthday\": \"1990-01-01\",\n  \"defaultCurrency\": \"USD\",\n  \"status\": \"active\",\n  \"verifyToken\": \"{{verifyTokenFromVerifyOtp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Completes registration for users who passed OTP verification. Use the `verifyToken` returned by Verify OTP."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Returns a fresh `{ accessToken, refreshToken }` pair. Body property name is `token` (refresh token)."
          }
        }
      ]
    },
    {
      "name": "Favorites",
      "item": [
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/favorites?entityType=product&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["favorites"],
              "query": [
                { "key": "entityType", "value": "product", "description": "product|merchant (optional)" },
                { "key": "limit", "value": "20", "description": "Optional; pipe requires number" },
                { "key": "offset", "value": "0", "description": "Optional; pipe requires number" }
              ]
            },
            "description": "Requires Authorization. Lists favorites for the user."
          }
        },
        {
          "name": "Check Favorite",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/favorites/check/product/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["favorites", "check", "product", "{{productId}}"]
            },
            "description": "Requires Authorization. Returns `{ is_favorite: boolean }` for entity."
          }
        },
        {
          "name": "Add Favorite",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity_type\": \"product\",\n  \"entity_id\": {{productId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/favorites",
              "host": ["{{baseUrl}}"],
              "path": ["favorites"]
            },
            "description": "Requires Authorization. Adds a product or merchant to favorites."
          }
        },
        {
          "name": "Remove Favorite",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/favorites/product/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["favorites", "product", "{{productId}}"]
            },
            "description": "Requires Authorization. Removes a favorite."
          }
        }
      ]
    },
