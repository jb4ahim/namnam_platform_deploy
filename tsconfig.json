{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,                         
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,                   
    "strictBindCallApply": true,             
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,                 
    "resolveJsonModule": true,              
    "types": ["node"],                       
    "paths": {
      "@namnam/common": [
        "libs/common/src"
      ],
      "@namnam/common/*": [
        "libs/common/src/*"
      ],
      "@namnam/database": ["libs/database/src"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts"
  ],
  "include": [
    "apps/**/*",
    "libs/**/*"
  ]
}
