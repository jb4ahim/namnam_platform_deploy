{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/customer_api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/customer_api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/customer_api",
  "projects": {
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "customer_api": {
      "type": "application",
      "root": "apps/customer_api",
      "entryFile": "main",
      "sourceRoot": "apps/customer_api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer_api/tsconfig.app.json",
        "plugins": ["@nestjs/swagger"]
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "management_api": {
      "type": "application",
      "root": "apps/management_api",
      "entryFile": "main",
      "sourceRoot": "apps/management_api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/management_api/tsconfig.app.json",
        "plugins": ["@nestjs/swagger"]
      }
    },
    "merchant_api": {
      "type": "application",
      "root": "apps/merchant_api",
      "entryFile": "main",
      "sourceRoot": "apps/merchant_api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/merchant_api/tsconfig.app.json",
        "plugins": ["@nestjs/swagger"]
      }
    },
    "notifications": {
      "type": "library",
      "root": "libs/notifications",
      "entryFile": "index",
      "sourceRoot": "libs/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notifications/tsconfig.lib.json"
      }
    },
    "storage": {
      "type": "library",
      "root": "libs/storage",
      "entryFile": "index",
      "sourceRoot": "libs/storage/src",
      "compilerOptions": {
        "tsConfigPath": "libs/storage/tsconfig.lib.json"
      }
    }
  }
}