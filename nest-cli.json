{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/restaurant-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/restaurant-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/restaurant-api",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "customer-api": {
      "type": "application",
      "root": "apps/customer-api",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer-api/tsconfig.app.json"
      }
    },
    "management-api": {
      "type": "application",
      "root": "apps/management-api",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "apps/management-api/tsconfig.app.json"
      }
    },
    "restaurant-api": {
      "type": "application",
      "root": "apps/restaurant-api",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "apps/restaurant-api/tsconfig.app.json"
      }
    }
  }
}