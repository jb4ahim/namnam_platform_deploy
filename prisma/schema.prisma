generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model analytics_views {
  analytics_view_id Int         @id @default(autoincrement())
  entity_type       entity_type
  entity_id         Int
  user_id           Int?
  viewed_at         DateTime?   @default(now()) @db.Timestamp(6)
  users             users?      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_analytics_views_entity_type_id")
  @@index([user_id], map: "idx_analytics_views_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model app_config {
  id         Int       @id @default(autoincrement())
  key        String    @unique @db.VarChar(255)
  value      Json
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([key], map: "idx_app_config_key")
}

model audit_logs {
  audit_log_id Int        @id @default(autoincrement())
  user_type    user_type?
  user_id      Int?
  action       String     @db.VarChar(255)
  entity       String     @db.VarChar(255)
  entity_id    Int?
  ip_address   String?    @db.Inet
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  users        users?     @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model bearer_tokens {
  bearer_token_id Int       @id @default(autoincrement())
  user_id         Int
  token           String    @unique @db.VarChar(500)
  refresh_token   String?   @db.VarChar(500)
  expires_at      DateTime  @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_bearer_tokens_expires_at")
  @@index([token], map: "idx_bearer_tokens_token")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bundle_items {
  bundle_id  Int
  product_id Int
  quantity   Int      @default(1)
  bundles    bundles  @relation(fields: [bundle_id], references: [bundle_id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([bundle_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bundles {
  bundle_id     Int            @id @default(autoincrement())
  restaurant_id Int
  name          String         @db.VarChar(255)
  description   String?
  bundle_price  Decimal        @db.Decimal(10, 2)
  image_url     String?        @db.VarChar(500)
  is_active     Boolean?       @default(true)
  status        status_type?   @default(active)
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  bundle_items  bundle_items[]
  merchants     merchants      @relation(fields: [restaurant_id], references: [merchant_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  cart_item_id   Int            @id @default(autoincrement())
  cart_id        Int
  product_id     Int
  quantity       Int
  shopping_carts shopping_carts @relation(fields: [cart_id], references: [cart_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart")
  products       products       @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product")
}

model catalog_sections {
  section_id       Int                @id @default(autoincrement())
  merchant_id      Int
  section_title_ar String?            @db.VarChar
  section_title_en String?            @db.VarChar
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  is_disabled      Boolean?           @default(false)
  is_deleted       Boolean?           @default(false)
  display_order    Int                @default(0)
  merchants        merchants          @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_sections_merchant")
  products         products[]
  section_products section_products[]
}

model categories {
  category_id        Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  type               category_type?
  parent_id          Int?
  status             status_type?         @default(active)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  image_key          String?              @db.VarChar
  categories         categories?          @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories   categories[]         @relation("categoriesTocategories")
  merchants          merchants[]
  product_categories product_categories[]
  promotions         promotions[]
}

model chat_conversations {
  chat_conversation_id                     Int             @id @default(autoincrement())
  user1_type                               user_type
  user1_id                                 Int
  user2_type                               user_type
  user2_id                                 Int
  created_at                               DateTime?       @default(now()) @db.Timestamp(6)
  users_chat_conversations_user1_idTousers users           @relation("chat_conversations_user1_idTousers", fields: [user1_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users_chat_conversations_user2_idTousers users           @relation("chat_conversations_user2_idTousers", fields: [user2_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  chat_messages                            chat_messages[]
}

model chat_messages {
  chat_message_id    Int                @id @default(autoincrement())
  conversation_id    Int
  sender_type        sender_type
  sender_id          Int
  message            String
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  chat_conversations chat_conversations @relation(fields: [conversation_id], references: [chat_conversation_id], onDelete: Cascade, onUpdate: NoAction)
  users              users              @relation(fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model cms_pages {
  cms_page_id Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  content     String?
  language    String?      @default("en") @db.VarChar(10)
  status      status_type? @default(active)
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
}

model components {
  component_id             Int                  @id @default(autoincrement())
  name                     String               @db.VarChar(255)
  description              String?
  default_price_adjustment Decimal?             @default(0.00) @db.Decimal(10, 2)
  is_global                Boolean?             @default(false)
  created_by               Int?
  status                   status_type?         @default(active)
  created_at               DateTime?            @default(now()) @db.Timestamp(6)
  merchant_users           merchant_users?      @relation(fields: [created_by], references: [merchant_user_id], onDelete: NoAction, onUpdate: NoAction)
  product_components       product_components[]
}

model coupon_redemptions {
  redemption_id   Int       @id @default(autoincrement())
  coupon_id       Int
  user_id         Int
  order_id        Int?
  discount_amount Decimal   @db.Decimal(10, 2)
  redeemed_at     DateTime? @default(now()) @db.Timestamp(6)
  coupons         coupons   @relation(fields: [coupon_id], references: [coupon_id], onDelete: Cascade, onUpdate: NoAction)
  orders          orders?   @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  coupon_id               Int                  @id @default(autoincrement())
  code                    String               @unique @db.VarChar(50)
  name                    String               @db.VarChar(255)
  description             String?
  discount_type           String               @db.VarChar(50)
  discount_value          Decimal              @db.Decimal(10, 2)
  max_discount_amount     Decimal?             @db.Decimal(10, 2)
  min_order_amount        Decimal?             @db.Decimal(10, 2)
  starts_at               DateTime?            @db.Timestamp(6)
  ends_at                 DateTime?            @db.Timestamp(6)
  is_active               Boolean?             @default(true)
  max_redemptions         Int?
  current_redemptions     Int?                 @default(0)
  per_user_limit          Int?
  applicable_merchant_ids Int[]
  applicable_product_ids  Int[]
  rules                   Json?
  created_at              DateTime?            @default(now()) @db.Timestamp(6)
  updated_at              DateTime?            @default(now()) @db.Timestamp(6)
  coupon_redemptions      coupon_redemptions[]

  @@index([code], map: "idx_coupons_code")
  @@index([starts_at, ends_at], map: "idx_coupons_dates")
  @@index([is_active], map: "idx_coupons_is_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_favorites {
  favorite_id Int       @id @default(autoincrement())
  customer_id Int
  entity_type String    @db.VarChar(50)
  entity_id   Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  customers   customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customer_id, entity_type, entity_id])
  @@index([created_at], map: "idx_customer_favorites_created_at")
  @@index([customer_id], map: "idx_customer_favorites_customer_id")
  @@index([entity_type, entity_id], map: "idx_customer_favorites_entity")
}

model customer_preferences {
  preference_id         Int       @id @default(autoincrement())
  customer_id           Int       @unique
  language              String?   @default("en") @db.VarChar(10)
  currency              String?   @default("EGP") @db.VarChar(3)
  notifications_enabled Boolean?  @default(true)
  email_notifications   Boolean?  @default(true)
  push_notifications    Boolean?  @default(true)
  sms_notifications     Boolean?  @default(false)
  marketing_emails      Boolean?  @default(false)
  theme                 String?   @default("light") @db.VarChar(20)
  timezone              String?   @default("Africa/Cairo") @db.VarChar(50)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  customers             customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_customer_preferences_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_reviews {
  review_id            Int                    @id @default(autoincrement())
  customer_id          Int
  entity_type          String                 @db.VarChar(50)
  entity_id            Int
  rating               Decimal                @db.Decimal(2, 1)
  comment              String?
  is_verified_purchase Boolean?               @default(false)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  customers            customers              @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  review_helpful_votes review_helpful_votes[]

  @@unique([customer_id, entity_type, entity_id])
  @@index([created_at], map: "idx_customer_reviews_created_at")
  @@index([customer_id], map: "idx_customer_reviews_customer_id")
  @@index([entity_type, entity_id], map: "idx_customer_reviews_entity")
  @@index([rating], map: "idx_customer_reviews_rating")
}

model customers {
  customer_id           Int                    @id
  gender                gender_type?
  birthday              DateTime?              @db.Date
  default_currency      currency_type?         @default(USD)
  status                status_type?           @default(active)
  language              String?                @default("en") @db.VarChar(10)
  currency              String?                @default("EGP") @db.VarChar(3)
  notifications_enabled Boolean?               @default(true)
  email_notifications   Boolean?               @default(true)
  push_notifications    Boolean?               @default(true)
  sms_notifications     Boolean?               @default(false)
  marketing_emails      Boolean?               @default(false)
  theme                 String?                @default("light") @db.VarChar(20)
  timezone              String?                @default("Africa/Cairo") @db.VarChar(50)
  created_at            DateTime?              @default(now()) @db.Timestamp(6)
  updated_at            DateTime?              @default(now()) @db.Timestamp(6)
  profile_image_key     String?                @default("") @db.VarChar(250)
  customer_favorites    customer_favorites[]
  customer_preferences  customer_preferences?
  customer_reviews      customer_reviews[]
  users                 users                  @relation(fields: [customer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  orders                orders[]
  review_helpful_votes  review_helpful_votes[]
  shopping_carts        shopping_carts[]
  user_addresses        user_addresses[]
  referral_codes        referral_codes?
  referral_uses         referral_uses?
}

model delivery_tracking_history {
  delivery_tracking_history_id Int               @id @default(autoincrement())
  order_id                     Int
  driver_id                    Int?
  status                       order_status_type
  latitude                     Decimal?          @db.Decimal(10, 8)
  longitude                    Decimal?          @db.Decimal(11, 8)
  updated_at                   DateTime?         @default(now()) @db.Timestamp(6)
  users                        users?            @relation(fields: [driver_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  orders                       orders            @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model delivery_zones {
  delivery_zone_id    Int          @id @default(autoincrement())
  name                String       @db.VarChar(255)
  polygon_coordinates String?
  delivery_fee        Decimal?     @default(0.00) @db.Decimal(10, 2)
  status              status_type? @default(active)
  created_at          DateTime?    @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model driver_performance {
  driver_performance_id Int       @id @default(autoincrement())
  driver_id             Int
  orders_completed      Int?      @default(0)
  average_rating        Decimal?  @db.Decimal(3, 2)
  last_updated          DateTime? @default(now()) @db.Timestamp(6)
  users                 users     @relation(fields: [driver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model entities {
  entity_id          Int             @id @default(autoincrement())
  entity_name        String          @db.VarChar(255)
  entity_description String?
  is_active          Boolean?        @default(true)
  created_at         DateTime?       @default(now()) @db.Timestamp(6)
  updated_at         DateTime?       @default(now()) @db.Timestamp(6)
  entity_status      entity_status[]
  reasons            reasons[]
}

model entity_status {
  status_id        Int          @id @default(autoincrement())
  entity_id        Int
  entity_record_id String       @db.VarChar(255)
  status_type_id   Int
  reason_id        Int?
  status_date      DateTime?    @default(now()) @db.Timestamp(6)
  created_by       String?      @db.VarChar(255)
  deleted_at       DateTime?    @db.Timestamp(6)
  deleted_by       String?      @db.VarChar(255)
  entities         entities     @relation(fields: [entity_id], references: [entity_id], onDelete: Cascade, onUpdate: NoAction)
  reasons          reasons?     @relation(fields: [reason_id], references: [reason_id], onDelete: NoAction, onUpdate: NoAction)
  status_types     status_types @relation(fields: [status_type_id], references: [status_type_id], onDelete: NoAction, onUpdate: NoAction)
}

model favorites {
  user_id    Int
  product_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model group_choice_options {
  choice_id             BigInt                @id @default(autoincrement())
  group_id              BigInt
  choice_name           String                @db.VarChar(255)
  choice_name_ar        String                @db.VarChar(255)
  price                 Decimal               @default(0) @db.Decimal(10, 2)
  is_active             Boolean?              @default(true)
  display_order         Int?                  @default(0)
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  product_choice_groups product_choice_groups @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([group_id], map: "idx_group_choice_options_group_id")
}

model images {
  image_id        Int               @id @default(autoincrement())
  file_key        String            @db.VarChar(255)
  uploaded_at     DateTime?         @default(now()) @db.Timestamp(6)
  merchant_images merchant_images[]
}

model management_users {
  management_user_id Int          @id
  status             status_type? @default(active)
  password_hash      String       @db.VarChar(255)
  users              users        @relation(fields: [management_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model meal_categories {
  meal_category_id Int          @id @default(autoincrement())
  name             String       @db.VarChar(255)
  description      String?
  status           status_type? @default(active)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
}

model merchant_contact_persons {
  merchant_contact_person_id Int        @id(map: "restaurant_contact_persons_pkey") @default(autoincrement())
  merchant_id                Int?       @unique(map: "unique_restaurant_id")
  first_name                 String?    @db.VarChar(100)
  last_name                  String?    @db.VarChar(100)
  role                       String?    @db.VarChar(100)
  email_address              String?    @db.VarChar(100)
  phone_number               String?    @db.VarChar(100)
  merchants                  merchants? @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_restaurant")
}

model merchant_hours {
  merchant_hour_id Int              @id(map: "restaurant_hours_pkey") @default(autoincrement())
  merchant_id      Int
  day_of_week      day_of_week_type
  open_time        DateTime?        @db.Time(6)
  close_time       DateTime?        @db.Time(6)
  is_closed        Boolean?         @default(false)
  status           status_type?     @default(active)
  merchants        merchants        @relation(fields: [merchant_id], references: [merchant_id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_hours_restaurant_id_fkey")

  @@unique([merchant_id, day_of_week], map: "restaurant_hours_restaurant_id_day_of_week_key")
}

model merchant_images {
  merchant_id Int
  image_id    Int
  images      images    @relation(fields: [image_id], references: [image_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_image")
  merchants   merchants @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_restaurant")

  @@id([merchant_id, image_id], map: "restaurant_images_pkey")
}

model merchant_requests {
  merchant_request_id Int                     @id @default(autoincrement())
  merchant_id         Int
  status              merchant_request_status
  rejection_reason    String?                 @db.VarChar(500)
  step_id             Int?
  created_at          DateTime?               @default(now()) @db.Timestamp(6)
  merchants           merchants               @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_merchant_id")
}

model merchant_users {
  merchant_user_id Int          @id(map: "merchants_pkey")
  status           status_type? @default(active)
  merchant_id      Int
  merchant_role    String       @db.VarChar
  password_hash    String       @db.VarChar(255)
  fcm_token        String?      @db.VarChar(255)
  components       components[]
  merchants        merchants    @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_merchants_restaurant")
  users            users        @relation(fields: [merchant_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "merchants_merchant_id_fkey")
}

model merchants {
  merchant_id              Int                       @id(map: "restaurants_pkey") @default(autoincrement())
  name                     String?                   @db.VarChar(255)
  description              String?
  is_owned_by_app          Boolean?                  @default(false)
  latitude                 Decimal?                  @db.Decimal(10, 8)
  longitude                Decimal?                  @db.Decimal(11, 8)
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  cover_key                String?                   @db.VarChar(255)
  logo_key                 String?                   @db.VarChar(255)
  category_id              Int?
  building                 String?                   @db.VarChar
  street                   String?                   @db.VarChar
  notes                    String?                   @db.VarChar
  hotline_number           String?                   @db.VarChar
  fcm_token                String?                   @db.VarChar(255)
  zone_id                  Int?
  is_active                Boolean?                  @default(true)
  view_counter             Int?
  bundles                  bundles[]
  catalog_sections         catalog_sections[]
  merchant_contact_persons merchant_contact_persons?
  merchant_hours           merchant_hours[]
  merchant_images          merchant_images[]
  merchant_requests        merchant_requests[]
  merchant_users           merchant_users[]
  categories               categories?               @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category")
  zones                    zones?                    @relation(fields: [zone_id], references: [zone_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_merchant_zone_id")
  orders                   orders[]
  products                 products[]
  shopping_carts           shopping_carts[]

  @@index([latitude, longitude], map: "idx_restaurants_location")
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  user_id         Int
  title           String    @db.VarChar(255)
  message         String
  data            Json?
  is_read         Boolean?  @default(false)
  is_sent         Boolean?  @default(false)
  sent_at         DateTime? @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_notifications_created_at")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
}

model order_components {
  order_component_id   Int                    @id @default(autoincrement())
  order_item_id        Int
  product_component_id Int
  action               component_action_type? @default(add)
  order_items          order_items            @relation(fields: [order_item_id], references: [order_item_id], onDelete: Cascade, onUpdate: NoAction)
  product_components   product_components     @relation(fields: [product_component_id], references: [product_component_id], onDelete: NoAction, onUpdate: NoAction)
}

model order_delivery_snapshots {
  snapshot_id            Int       @id @default(autoincrement())
  order_id               Int
  delivery_address_line1 String?
  delivery_address_line2 String?
  delivery_city          String?   @db.VarChar(100)
  delivery_state         String?   @db.VarChar(100)
  delivery_postal_code   String?   @db.VarChar(20)
  delivery_country       String?   @db.VarChar(100)
  delivery_latitude      Decimal?  @db.Decimal(10, 8)
  delivery_longitude     Decimal?  @db.Decimal(11, 8)
  delivery_label         String?   @db.VarChar(50)
